{
  // Vérification des types du JavaScript (sans compilation) : npm run typecheck
  // TypeScript lit le JavaScript et les annotations JSDoc ; rien n'est généré.
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["assets/js/**/*.js", "scripts/**/*.mjs", "tests/**/*.js", "*.config.js"],
  "exclude": ["assets/vendor"]
}
